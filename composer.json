{
    "name": "jnana/jnana",
    "description": "Project skeleton for the Jnana framework. Run `composer create-project jnana/jnana my-app` to get a working app with a welcome page out of the box.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "jnana/framework": "^1.0.1",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.4",
        "doctrine/migrations": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Bootstrap.php"
        ]
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"@mkdir('storage/framework/logs', 0777, true); @mkdir('storage/framework/temp/cache', 0777, true);\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
