{
  "name": "jnana/jnana",
  "description": "Project skeleton for the Jnana framework. Run `composer create-project jnana/jnana my-app` to create a working application with a welcome page out of the box.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "jnana/framework": "^1.0",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.4",
    "doctrine/migrations": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Bootstrap.php"
    ]
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"if (!file_exists('.env') && file_exists('.env.example')) { copy('.env.example', '.env'); }\"",
      "@php -r \"foreach (['storage/framework/logs', 'storage/framework/temp/cache'] as $dir) { if (!is_dir($dir)) { mkdir($dir, 0775, true); } }\""
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
