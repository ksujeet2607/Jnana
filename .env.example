# Environment and Security Settings
DEFAULT_DOMAIN = '/'
APP_NAME = 'Easy App'
APP_ENV = 'development' # development/production/maintenance
APP_DEBUG = 'true'
CACHING = 'false'
TIMEZONE = 'UTC'
CSRF_VALIDATION = true

# Database Variables
# Leave DB_DATABASE empty to boot without a database (NullDatabase).
# Fill these in and switch AUTH_STRATEGY to 'database' once you're ready.
DB_HOST = '127.0.0.1'
DB_USERNAME = 'root'
DB_PASSWORD = ''
DB_DATABASE = ''
DB_DRIVER = 'pdo_mysql'

# Authentication
# 'file' reads config/users.json (default admin / password: "password")
# 'database' looks up the users table via App\Entities\Support\User
AUTH_STRATEGY = 'file'
USER_FILE_PATH = ''

# Session and CSRF security
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_TIMEOUT=0
SESSION_ABSOLUTE_TIMEOUT=0
CSRF_TOKEN_LIFETIME=7200
SECURITY_HSTS=0

# Login rate limiting (attach LoginRateLimitMiddleware to login POST routes)
LOGIN_RATE_LIMIT_ENABLED=1
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_IDENTIFIER_FIELD=username
# Optional: shared writable directory for file-backed rate limits
SECURITY_RATE_LIMIT_DIR=

# Secure file upload policy (stored under storage/, outside public/)
SECURE_UPLOADS_ENABLED=1
UPLOAD_MAX_BYTES=5242880
