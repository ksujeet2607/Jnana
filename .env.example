# Environment and Security Settings
DEFAULT_DOMAIN = '/'
APP_NAME = 'Jnana App'
APP_ENV = 'development' # development/production/maintenance
APP_DEBUG = 'true'
CACHING = 'false'
TIMEZONE = 'UTC'
CSRF_VALIDATION = true

# Database Variables
# Leave DB_DATABASE empty to boot without a database (NullDatabase).
# Fill these in and switch AUTH_STRATEGY to 'database' once you're ready.
DB_HOST = '127.0.0.1'
DB_USERNAME = 'root'
DB_PASSWORD = ''
DB_DATABASE = ''
DB_DRIVER = 'pdo_mysql'

# Authentication
# 'file' reads config/users.json (default admin / password: "password")
# 'database' looks up the users table via App\Entities\Support\User
AUTH_STRATEGY = 'file'
USER_FILE_PATH = ''

# Session and CSRF security
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_TIMEOUT=0
SESSION_ABSOLUTE_TIMEOUT=0
CSRF_TOKEN_LIFETIME=7200
SECURITY_HSTS=0
